# Referência de configuração. Defina as variáveis no PowerShell.
# O chat não carrega este arquivo automaticamente.
OPENAI_API_KEY=SUA_CHAVE_AQUI
OPENAI_BASE_URL=http://127.0.0.1:9931/v1
OPENAI_MODEL=unsloth/GLM-4.7-Flash-GGUF:UD-Q4_K_XL
# Use o nome exato do modelo servido pelo seu endpoint.
# Para a OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1
# Em servidor local sem autenticação, use OPENAI_API_KEY=local.


# Ambiente IPED (equivalente a configurar_ambiente.ps1)
IPED_HOME=D:\IPED-4.3.1_and_java_plugins\iped-4.3.1
JAVA_HOME=D:\IPED-4.3.1_and_java_plugins\iped-4.3.1\jre
IPED_CASE=D:\iped_mcp\caso_sintetico
IPED_CASE_LABEL=AURORA_SINTETICO
# 1 permite gravar marcadores; 0 apenas consulta
IPED_ALLOW_BOOKMARK_WRITE=1
